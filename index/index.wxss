/* pages/index/index.wxss —— Liquid Glass 风格 */

.page {
  min-height: 100vh;
  padding: 24rpx;
  position: relative;
}

/* 纯色浅蓝渐变背景 */
.bg {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 18% 14%, rgba(150, 200, 255, 0.55), transparent 50%),
    radial-gradient(circle at 82% 22%, rgba(190, 225, 255, 0.50), transparent 50%),
    radial-gradient(circle at 70% 85%, rgba(200, 230, 255, 0.55), transparent 50%),
    radial-gradient(circle at 25% 88%, rgba(180, 215, 255, 0.45), transparent 50%),
    linear-gradient(180deg, #eaf4ff, #f2f8ff);
}

/* 通用玻璃质感 */
.glass {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(47, 134, 232, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* 顶栏 */
.header {
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2b2f42;
  letter-spacing: 1rpx;
}
.sub {
  font-size: 24rpx;
  color: #8a90a6;
  margin-top: 6rpx;
}
.sortbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}
.count {
  font-size: 24rpx;
  color: #6b7186;
}
.sortbtn {
  font-size: 24rpx;
  color: #3a93ff;
  background: rgba(58, 147, 255, 0.12);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}
.headbtns {
  display: flex;
  align-items: center;
}
.clearbtn {
  font-size: 24rpx;
  color: #e8635b;
  background: rgba(232, 99, 91, 0.12);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

/* 列表 */
.list {
  height: calc(100vh - 340rpx);
}
.card {
  display: flex;
  align-items: flex-start;
  padding: 26rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  transition: all 0.3s ease;
}
.card.overdue {
  border-color: rgba(232, 99, 91, 0.45);
}

/* 勾选圆 */
.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #b9c2dd;
  flex-shrink: 0;
  margin-right: 22rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
}
.check.checked {
  background: linear-gradient(135deg, #3a93ff, #2f86e8);
  border-color: transparent;
  box-shadow: 0 6rpx 14rpx rgba(58, 147, 255, 0.40);
}
.checkmark {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

/* 内容 */
.body {
  flex: 1;
  min-width: 0;
}
.cardtitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2f42;
}
.content {
  font-size: 26rpx;
  color: #6b7186;
  margin-top: 8rpx;
  line-height: 1.5;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.chip {
  font-size: 22rpx;
  color: #6b7186;
  background: rgba(255, 255, 255, 0.70);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.chip.remind {
  color: #3a93ff;
  background: rgba(58, 147, 255, 0.12);
}
.chip.warn {
  color: #e8635b;
  background: rgba(232, 99, 91, 0.12);
}

/* 删除按钮 */
.actions {
  margin-left: 12rpx;
  flex-shrink: 0;
}
.delbtn {
  font-size: 26rpx;
  color: #3a93ff;
  background: rgba(58, 147, 255, 0.12);
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
}

/* 已完成置灰 */
.card.done {
  opacity: 0.55;
}
.card.done .cardtitle {
  text-decoration: line-through;
  color: #9aa0b4;
}
.card.done .content {
  color: #aaafc0;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3a93ff, #2f86e8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(58, 147, 255, 0.50);
  z-index: 50;
}
.fabplus {
  color: #fff;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(20, 24, 40, 0.35);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheethead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2f42;
  margin-bottom: 28rpx;
}
.close {
  font-size: 36rpx;
  color: #9aa0b4;
  padding: 0 10rpx;
}
.field {
  margin-bottom: 26rpx;
}
.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  font-size: 26rpx;
  color: #6b7186;
  display: block;
  margin-bottom: 12rpx;
}
.field.row .label {
  margin-bottom: 0;
}
.input {
  background: rgba(255, 255, 255, 0.70);
  border: 1rpx solid rgba(255, 255, 255, 0.80);
  border-radius: 20rpx;
  padding: 24rpx;
  height: 96rpx;
  font-size: 30rpx;
  color: #2b2f42;
  width: 100%;
  line-height: 48rpx;
  box-sizing: border-box;
}
.area {
  height: 160rpx;
  line-height: 44rpx;
}
/* 补充说明：可折叠入口 */
.addcontent {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
  padding: 22rpx 24rpx;
  border: 1rpx dashed rgba(58, 147, 255, 0.45);
  border-radius: 20rpx;
  background: rgba(58, 147, 255, 0.06);
  font-size: 28rpx;
  color: #3a93ff;
}
.addcontent .plus {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 10rpx;
}
.pickerbox {
  flex: 1;
}
.pickerbox:first-child {
  margin-right: 20rpx;
}
.picker {
  background: rgba(255, 255, 255, 0.70);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #2b2f42;
}
.reminder-row {
  padding: 16rpx 0;
}
.savebtn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #3a93ff, #2f86e8);
  color: #fff;
  text-align: center;
  padding: 26rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(58, 147, 255, 0.40);
}

/* 空状态 */
.empty {
  text-align: center;
  color: #8a90a6;
  padding-top: 160rpx;
  font-size: 28rpx;
}
.emptyglyph {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.bottomspace {
  height: 160rpx;
}
